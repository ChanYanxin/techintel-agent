# Offline extraction is the default and needs no paid API key.
SCIW_MODEL_MODE=offline
# To enable remote LLM synthesis with an OpenAI-compatible chat completions endpoint:
# SCIW_MODEL_MODE=openai
# SCIW_OPENAI_API_KEY=replace_me
# SCIW_OPENAI_MODEL=gpt-4.1-mini
# SCIW_OPENAI_BASE_URL=https://api.openai.com/v1
# Optional trace capture by LangSmith (not enabled automatically)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=replace_me
# LANGSMITH_PROJECT=scientific-research-copilot
# TypeScript MCP server is opt-in (requires npm install && npm run build)
SCIW_USE_MCP=false
# SCIW_EXPERIMENTS_CSV=./data/experiments_demo.csv
